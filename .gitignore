node_modules/

# Upstream fonts (9-17 MB each) — re-fetched by the build, pinned by SHA.
.cache/

# Generated by scripts/build.mjs. Kept out of git so the repo stays text-only;
# `npm run build` recreates them byte-for-byte from the pinned upstream.
packages/*/*.ttf
packages/*/index.js
packages/*/index.d.ts
packages/*/package.json
packages/*/README.md
packages/*/OFL.txt
